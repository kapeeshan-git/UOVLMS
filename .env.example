# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# MySQL (create the schema/users with db/init/01_schema_and_users.sql in MySQL Workbench)
DB_ENGINE=mysql
DB_NAME=lms
DB_USER=lms
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Email: leave EMAIL_HOST empty to write emails to var/mail/ (no mail server needed).
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=library@vau.ac.lk

# Demo only
DEMO_CLOCK_ENABLED=true
DEMO_PASSWORD=demo1234
