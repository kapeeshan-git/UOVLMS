# Copy to .env and edit if needed. Never commit .env.
DJANGO_SECRET_KEY=uov-lms-dev-secret-key-change-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5173

# Local MySQL Server + MySQL Workbench (run db/init/01_schema_and_users.sql first)
DB_ENGINE=mysql
DB_NAME=lms
DB_USER=lms
DB_PASSWORD=lms1234
DB_HOST=127.0.0.1
DB_PORT=3306

# Email: leave EMAIL_HOST empty to capture emails in backend/var/mail/ and DB outbox
EMAIL_HOST=
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=library@vau.ac.lk

# Demo tools
DEMO_CLOCK_ENABLED=true
DEMO_PASSWORD=demo1234
